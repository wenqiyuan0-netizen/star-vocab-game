# Copy to .env.local and fill in. All REACT_APP_* values are embedded in the
# client bundle, so only put PUBLIC values here.

# Supabase (optional — without these the web app runs in local-only guest mode)
# The anon / publishable key is public by design; data is protected by RLS.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Set to true to build the pure offline version (used for the desktop .exe)
REACT_APP_OFFLINE=false

# NOTE: never put a Gemini key or a Supabase service_role key here.
# AI features use each user's own key, entered in the app (Profile → AI).
