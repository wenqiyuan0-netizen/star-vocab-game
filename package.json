{
  "name": "star-vocab-game",
  "version": "0.3.0",
  "private": true,
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env INLINE_RUNTIME_CHUNK=false GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "cross-env NODE_ENV=development PORT=3002 REACT_APP_OFFLINE=true BROWSER=none concurrently \"react-scripts start\" \"wait-on http://localhost:3002 && electron .\"",
    "electron:pack": "npm run build:offline && electron-builder --win --publish never",
    "lint": "eslint src --ext .js,.jsx",
    "test:ci": "react-scripts test --watchAll=false --passWithNoTests",
    "build:offline": "cross-env REACT_APP_OFFLINE=true INLINE_RUNTIME_CHUNK=false GENERATE_SOURCEMAP=false react-scripts build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.86.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "he": "^1.2.0",
    "lucide-react": "^0.554.0",
    "matter-js": "^0.20.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.18",
    "wait-on": "^7.2.0",
    "web-vitals": "^2.1.4"
  },
  "build": {
    "appId": "xyz.mesaculpa.starvocab",
    "productName": "Star Vocab",
    "artifactName": "StarVocab-${version}-${arch}.${ext}",
    "files": [
      "build/**/*",
      "electron.js",
      "!build/dict/lemma_index.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "StarVocab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StarVocab-Portable-${version}.${ext}"
    },
    "compression": "maximum",
    "extends": null
  },
  "description": "Star Vocab — gamified German vocabulary trainer with spaced repetition",
  "author": "wenqiyuan0-netizen"
}
